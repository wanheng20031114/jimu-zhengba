[node name="Help" type="Label" parent="Sidebar/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "右键 / Esc 退出放置 · R 旋转\nF2 全选当前阵营军队 · Delete 移除\n中键拖动 · 滚轮缩放 · 方向键移动\n不同颜色互为敌人，无胜负限制"
