[sub_resource type="Shader" id="Shader_health"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled, depth_test_disabled, shadows_disabled;\ninstance uniform float health : hint_range(0.0, 1.0) = 1.0;\ninstance uniform vec4 bar_color : source_color = vec4(0.53, 0.75, 0.33, 1.0);\nvoid vertex() {\n    mat4 billboard = mat4(\n        vec4(INV_VIEW_MATRIX[0].xyz * length(MODEL_MATRIX[0].xyz), 0.0),\n        vec4(INV_VIEW_MATRIX[1].xyz * length(MODEL_MATRIX[1].xyz), 0.0),\n        vec4(INV_VIEW_MATRIX[2].xyz * length(MODEL_MATRIX[2].xyz), 0.0),\n        MODEL_MATRIX[3]);\n    MODELVIEW_MATRIX = VIEW_MATRIX * billboard;\n}\nvoid fragment() {\n    vec2 edge = abs(UV - vec2(0.5));\n    vec2 inner_half_size = vec2(0.488, 0.445);\n    float border = step(inner_half_size.y, edge.y) + step(inner_half_size.x, edge.x);\n    vec3 background = vec3(0.075, 0.063, 0.052);\n    vec3 filled = bar_color.rgb * (0.83 + UV.y * 0.28);\n    float filled_right = mix(0.5 - inner_half_size.x, 0.5 + inner_half_size.x, clamp(health, 0.0, 1.0));\n    float amount = step(UV.x, filled_right);\n    ALBEDO = mix(mix(background * 1.7, filled, amount), background, min(border, 1.0));\n    ALPHA = 1.0;\n}"

