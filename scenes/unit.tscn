[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/battle_unit.gd" id="1_script"]

[sub_resource type="CapsuleShape3D" id="Capsule_body"]
resource_local_to_scene = true
radius = 0.42
height = 1.8

[sub_resource type="Shader" id="Shader_health"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled, depth_test_disabled, shadows_disabled;\ninstance uniform float health : hint_range(0.0, 1.0) = 1.0;\ninstance uniform vec4 bar_color : source_color = vec4(0.53, 0.75, 0.33, 1.0);\nvoid vertex() {\n    mat4 billboard = mat4(\n        vec4(INV_VIEW_MATRIX[0].xyz * length(MODEL_MATRIX[0].xyz), 0.0),\n        vec4(INV_VIEW_MATRIX[1].xyz * length(MODEL_MATRIX[1].xyz), 0.0),\n        vec4(INV_VIEW_MATRIX[2].xyz * length(MODEL_MATRIX[2].xyz), 0.0),\n        MODEL_MATRIX[3]);\n    MODELVIEW_MATRIX = VIEW_MATRIX * billboard;\n}\nvoid fragment() {\n    vec2 edge = abs(UV - vec2(0.5));\n    float border = step(0.445, edge.y) + step(0.488, edge.x);\n    vec3 background = vec3(0.075, 0.063, 0.052);\n    vec3 filled = bar_color.rgb * (0.83 + UV.y * 0.28);\n    float amount = step(UV.x, 0.025 + health * 0.95);\n    ALBEDO = mix(mix(background * 1.7, filled, amount), background, min(border, 1.0));\n    ALPHA = 1.0;\n}"

[sub_resource type="ShaderMaterial" id="Material_health"]
render_priority = 3
shader = SubResource("Shader_health")

[sub_resource type="QuadMesh" id="Mesh_health"]
material = SubResource("Material_health")
size = Vector2(1, 1)

[sub_resource type="Shader" id="Shader_selection"]
code = "shader_type spatial;\nrender_mode unshaded, shadows_disabled;\ninstance uniform vec4 ring_color : source_color = vec4(0.45, 0.83, 0.94, 1.0);\nvoid fragment() {\n    ALBEDO = ring_color.rgb;\n}"

[sub_resource type="ShaderMaterial" id="Material_selection"]
shader = SubResource("Shader_selection")

[sub_resource type="TorusMesh" id="Mesh_selection"]
