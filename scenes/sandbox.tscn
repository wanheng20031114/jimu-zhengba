[sub_resource type="Shader" id="vignette"]
code = "shader_type canvas_item;\nvoid fragment() {\n vec2 d = (UV - vec2(0.5, 0.43)) * vec2(1.12, 1.0);\n float edge = smoothstep(0.31, 0.76, length(d));\n float top = pow(1.0 - UV.y, 5.0) * 0.22;\n COLOR = vec4(0.085, 0.066, 0.047, edge * 0.43 + top);\n}"

