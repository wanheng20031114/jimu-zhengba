# Godot 4+ specific ignores
.godot/
/android/

# Build caches, machine-local scripts and validation output
__pycache__/
*.pyc
*.log
*.pid
.local/
tmp/
builds/
artifacts/*
!artifacts/.gdignore
!artifacts/battlefield.png
!artifacts/integration-results.json
tests/stress_*.png*
tests/stress_*.json
tests/isolated_*.png
assets/models/**/preview*.png*
assets/models/**/detail_*.png*
